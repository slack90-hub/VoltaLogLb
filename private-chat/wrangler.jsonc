{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mds-room",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "account_id": "f3073764cb377f9c39bcab97b9e7bab9",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "PrivateRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PrivateRoom"
      ]
    }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.html",
        "**/*.css",
        "**/*.txt"
      ],
      "fallthrough": true
    }
  ],
  "observability": {
    "enabled": false
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "vars": {
    "EMAIL_ENABLED": "true"
  }
}
